{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend with Nodemon",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "nodemon",
       "runtimeArgs": ["--inspect"],
      "program": "${workspaceFolder}/Server/src/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}